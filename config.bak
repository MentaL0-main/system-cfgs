# --- ОСНОВНЫЕ НАСТРОЙКИ ---
set $mod Mod4
font pango:CaskaydiaCove Nerd Font 13
floating_modifier $mod
gaps top 45

default_border pixel 1
default_floating_border pixel 1
for_window [class="^.*$"] border pixel 1
new_window none

bindsym $mod+Return exec alacritty
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym Print exec --no-startup-id flameshot gui
bindsym $mod+t exec alacritty --class task_tui -e vit

for_window [class="task_tui"] floating enable, move scratchpad

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Перемещение (Win + Shift + стрелки)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Рабочие столы
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2

# Управление i3
bindsym $mod+Shift+r restart
  
gaps inner 5
gaps outer 5

# Цвета: BORDER  BG      TEXT      INDICATOR 
client.focused #ffa500 #1a1a1a #ffffff #ffa500
client.unfocused #333333 #1a1a1a #888888 #333333

# --- АВТОЗАПУСК ---
exec_always --no-startup-id feh --bg-fill ~/Downloads/mojave-day.jpg
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always --no-startup-id setxkbmap -layout us,ru -option grp:alt_shift_toggle
exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id nm-applet
exec_always --no-startup-id polybar macos
